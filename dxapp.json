{
  "name": "eggd_pyTMB",
  "title": "eggd_pyTMB",
  "summary": "Calculates Tumour Mutational Burden (TMB) from an annotated VCF using pyTMB",
  "dxapi": "1.0.0",
  "version": "1.0.0",
  "properties": {
    "githubRelease": "1.0.0"
    },
  "inputSpec": [
    {
      "name": "bed",
      "class": "file",
      "optional": true,
      "default": {"$dnanexus_link": "file-GjBQ30Q4qv8xv4PB054qYFfX"},
      "label": "Capture BED file",
      "patterns": [
        "*.bed"
      ],
      "help": "Capture design BED file. Defaults to coding_unrestricted_GRCh38_myeloid_v1.2.bed."
    },
    {
      "name": "gtf",
      "class": "file",
      "optional": true,
      "default": {"$dnanexus_link": "file-J8812VQ46QQPK08P00VZZPgy"},
      "label": "GTF annotation file",
      "patterns": [
        "*.gtf", "*.gtf.gz"
      ],
      "help": "Genome annotation GTF file. Defaults to GENCODE v47 no-chr (GRCh38)."
    },
    {
      "name": "vcf",
      "class": "file",
      "optional": false,
      "label": "Annotated VCF file",
      "patterns": [
        "*.vcf", "*.vcf.gz"
      ],
      "help": "VEP-annotated VCF file (.vcf, .vcf.gz, .bcf, .bcf.gz)"
    },
    {
      "name": "bam",
      "class": "file",
      "optional": false,
      "label": "BAM file",
      "patterns": [
        "*.bam"
      ],
      "help": "BAM file used to compute sample-specific coverage-based effective genome size."
    },
    {
      "name": "bam_bai",
      "class": "file",
      "optional": false,
      "label": "BAM index file",
      "patterns": [
        "*.bam.bai", "*.bai"
      ],
      "help": "BAM index file (.bai) required by mosdepth for coverage computation."
    }
  ],
  "outputSpec": [
    {
      "name": "tmb_report",
      "class": "file",
      "label": "TMB report",
      "patterns": [
        "*.txt"
      ],
      "help": "Plain-text TMB report produced by pyTMB, including TMB score, 95% CI, and filter statistics."
    }
  ],
  "runSpec": {
    "timeoutPolicy": {
      "*": {
        "hours": 2
      }
    },
    "distribution": "Ubuntu",
    "release": "20.04",
    "version": "0",
    "interpreter": "bash",
    "file": "src/code.sh",
    "assetDepends": [
      {
        "name": "bedtools",
        "project": "project-Fkb6Gkj433GVVvj73J7x8KbV",
        "folder": "/app_assets/bedtools/bedtools_v2.30.0",
        "version": "2.30.0"
      },
      {
        "name": "htslib",
        "project": "project-Fkb6Gkj433GVVvj73J7x8KbV",
        "folder": "/app_assets/htslib/htslib_v1.15.0",
        "version": "1.15.0"
      },
      {
        "name": "python_packages",
        "project": "project-Fkb6Gkj433GVVvj73J7x8KbV",
        "folder": "/app_assets/python_packages/python_packages_v1.1.0",
        "version": "1.1.0"
      }
    ]
  },
  "developers":[
    "org-emee_1"
  ],
  "authorizedUsers": [
    "org-emee_1"
  ],
  "regionalOptions": {
    "aws:eu-central-1": {
      "systemRequirements": {
        "*": {
          "instanceType": "mem1_ssd1_v2_x2"
        }
      }
    }
  }
}
